# Copy to .env and fill in real values. NEVER commit .env.
# Full variable reference:
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables

# Cookie-signing secret. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64

# Encryption keys for MFA/2FA support. Generate each with: openssl rand -hex 16
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_me

# The URL agents/customers use to reach Chatwoot (also used in emails/links).
FRONTEND_URL=http://localhost:3001

# true only for the very first run (to create the admin account),
# then set to false and restart so strangers can't sign up.
ENABLE_ACCOUNT_SIGNUP=true

# ── Postgres ──
# POSTGRES_HOST/USERNAME/DATABASE are read by the Chatwoot app;
# POSTGRES_USER/DB are read by the postgres container image itself.
# Keep the pairs identical. Password: openssl rand -hex 16
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DB=chatwoot
POSTGRES_DATABASE=chatwoot
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_16

# ── Redis ──
# The app connects via REDIS_URL; the redis container reads REDIS_PASSWORD.
# Keep the password identical in both lines.
REDIS_PASSWORD=replace_with_openssl_rand_hex_16
REDIS_URL=redis://:replace_with_openssl_rand_hex_16@redis:6379

# Required for the bot/ service: lets Chatwoot deliver agent-bot webhooks to
# http://bot:3002 on the private compose network (SSRF guard exemption).
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# ── WhatsApp (Meta Cloud API) ──
# From developers.facebook.com → your app → App Settings → Basic.
# These are read via GlobalConfigService, which prefers the InstallationConfig
# DB row over ENV — and Chatwoot seeds those rows BLANK. A blank row wins, so
# setting these here does nothing until the rows are cleared or the values are
# entered in Super Admin → Settings → WhatsApp Embedded.
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=
# Embedded-signup ("Connect WhatsApp" popup) only. Leave blank when entering
# WABA keys by hand — that flow is aimed at platforms onboarding other
# companies' numbers, not at connecting your own.
WHATSAPP_CONFIGURATION_ID=

# Signature verification, and why APP_SECRET alone does not enable it:
# meta_signature_verification_required? returns FALSE for a whatsapp_cloud
# channel that was set up manually (no per-channel secret, source is not
# 'embedded_signup') — so Meta's X-Hub-Signature-256 is never checked and the
# webhook accepts unsigned POSTs. To turn it on, the secret must be stored on
# the CHANNEL, under provider_config['app_secret'] (see
# MetaTokenVerifyConcern::CHANNEL_APP_SECRET_KEYS). There is no UI field for
# it; set it via the API. Do this before exposing a stable production domain.

# NOTE: the per-inbox credentials (access token, phone_number_id,
# business_account_id) are NOT env vars — they live in the channel's
# provider_config jsonb, entered when creating the inbox in the UI.
#
# Webhook registration uses FRONTEND_URL above:
#   "#{FRONTEND_URL}/webhooks/whatsapp/#{phone_number}"
# Meta requires that to be public HTTPS, so localhost:3001 will fail on
# inbox create. Point FRONTEND_URL at a tunnel (or the real host) first.

# ── Support bot (bot/ service) ──
# Which LLM answers customers: "gemini" or "openai". Both paths live in
# bot/server.js behind one switch; flipping this var (+ docker compose up -d
# bot) is the whole migration, and the way back. Keep BOTH providers' keys
# set so either is one env flip away during an outage or repricing.
BOT_PROVIDER=gemini
GEMINI_API_KEY=replace_me
# "latest" alias tracks Google's newest flash model, avoiding retirements.
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=replace_me
# GPT-5.6 Luna = OpenAI's cost tier (chosen 2026-08-03: function calling +
# automatic prompt caching at $0.20/$1.20 per 1M). Set a monthly budget cap
# in the OpenAI dashboard — that, not code, is the runaway-cost guard.
OPENAI_MODEL=gpt-5.6-luna

# How the bot calls Chatwoot's API. Default (unset) = http://rails:3000 on
# the private compose network — correct for local. On PRODUCTION set the
# public HTTPS URL: FORCE_SSL 301s plain-HTTP API calls to https://rails:3000,
# where TLS meets a plain port and every bot reply dies with
# ERR_SSL_WRONG_VERSION_NUMBER (found the hard way, 2026-08-03).
# CHATWOOT_BASE_URL=https://chat.flightsmojo.com

# The bot's identity in Chatwoot. ACCOUNT_ID is 1 on a fresh install (the
# staging Mac is 2 for historical reasons) — a wrong value means the bot
# receives messages but every reply silently 404s. BOT_TOKEN is printed by
# scripts/provision.rb; paste it here, then: docker compose up -d bot
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=

# Booking status lookup tool (X-Api-Key auth). UAT endpoint works until the
# backend team supplies the production URL + key.
BOOKING_API_URL=
BOOKING_API_KEY=

# Per-inbox market map — this is what makes the bot quote the right currency.
# Keys are Chatwoot INBOX IDS (check the id|name|token lines provision.rb
# prints; a fresh install numbers the five web widgets 1-5, and WhatsApp
# inboxes added later continue from there). An inbox missing here gets a
# market-neutral prompt with no currency — no error, just vaguer answers.
INBOX_SITES={"1":"flightsmojo.in (India) — prices in ₹ INR","2":"flightsmojo.ae (UAE) — prices in AED","3":"flightsmojo.com (USA) — prices in $ USD","4":"flightsmojo.co.uk (UK) — prices in £ GBP","5":"flightsmojo.id (Indonesia) — prices in Rp IDR"}

# ── Storage ──
# local = files saved into the storage_data Docker volume (fine to start;
# switch to S3 when deploying for real).
ACTIVE_STORAGE_SERVICE=local

# Default UI language for new accounts.
DEFAULT_LOCALE=en

# ── Email sending (blank = emails silently skipped; fine for local testing) ──
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
