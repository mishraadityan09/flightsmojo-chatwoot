# Copy to .env and fill in real values. NEVER commit .env.
# Full variable reference:
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables

# Cookie-signing secret. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64

# Encryption keys for MFA/2FA support. Generate each with: openssl rand -hex 16
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_me

# The URL agents/customers use to reach Chatwoot (also used in emails/links).
FRONTEND_URL=http://localhost:3001

# true only for the very first run (to create the admin account),
# then set to false and restart so strangers can't sign up.
ENABLE_ACCOUNT_SIGNUP=true

# ── Postgres ──
# POSTGRES_HOST/USERNAME/DATABASE are read by the Chatwoot app;
# POSTGRES_USER/DB are read by the postgres container image itself.
# Keep the pairs identical. Password: openssl rand -hex 16
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DB=chatwoot
POSTGRES_DATABASE=chatwoot
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_16

# ── Redis ──
# The app connects via REDIS_URL; the redis container reads REDIS_PASSWORD.
# Keep the password identical in both lines.
REDIS_PASSWORD=replace_with_openssl_rand_hex_16
REDIS_URL=redis://:replace_with_openssl_rand_hex_16@redis:6379

# Required for the bot/ service: lets Chatwoot deliver agent-bot webhooks to
# http://bot:3002 on the private compose network (SSRF guard exemption).
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# Editing THIS FILE changes the config of every service (they all use
# env_file: .env). `docker compose up -d bot` would then recreate rails,
# postgres and redis too, because they are the bot's dependencies — that is a
# production restart. For a bot-only change always use:
#   docker compose up -d --no-deps bot

# ── WhatsApp (Meta Cloud API) ──
# From developers.facebook.com → your app → App Settings → Basic.
# These are read via GlobalConfigService, which prefers the InstallationConfig
# DB row over ENV — and Chatwoot seeds those rows BLANK. A blank row wins, so
# setting these here does nothing until the rows are cleared or the values are
# entered in Super Admin → Settings → WhatsApp Embedded.
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=
# Embedded-signup ("Connect WhatsApp" popup) only. Leave blank when entering
# WABA keys by hand — that flow is aimed at platforms onboarding other
# companies' numbers, not at connecting your own.
WHATSAPP_CONFIGURATION_ID=

# Signature verification, and why APP_SECRET alone does not enable it:
# meta_signature_verification_required? returns FALSE for a whatsapp_cloud
# channel that was set up manually (no per-channel secret, source is not
# 'embedded_signup') — so Meta's X-Hub-Signature-256 is never checked and the
# webhook accepts unsigned POSTs. To turn it on, the secret must be stored on
# the CHANNEL, under provider_config['app_secret'] (see
# MetaTokenVerifyConcern::CHANNEL_APP_SECRET_KEYS). There is no UI field for
# it; set it via the API. Do this before exposing a stable production domain.

# NOTE: the per-inbox credentials (access token, phone_number_id,
# business_account_id) are NOT env vars — they live in the channel's
# provider_config jsonb, entered when creating the inbox in the UI.
#
# Webhook registration uses FRONTEND_URL above:
#   "#{FRONTEND_URL}/webhooks/whatsapp/#{phone_number}"
# Meta requires that to be public HTTPS, so localhost:3001 will fail on
# inbox create. Point FRONTEND_URL at a tunnel (or the real host) first.

# ── Support bot (bot/ service) ──
# Which LLM answers customers: "gemini" or "openai". Both paths live in
# bot/server.js behind one switch; flipping this var (+ docker compose up -d
# bot) is the whole migration, and the way back. Keep BOTH providers' keys
# set so either is one env flip away during an outage or repricing.
BOT_PROVIDER=gemini
GEMINI_API_KEY=replace_me
# "latest" alias tracks Google's newest flash model, avoiding retirements.
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=replace_me
# GPT-5.6 Luna = OpenAI's cost tier (chosen 2026-08-03: function calling +
# automatic prompt caching at $0.20/$1.20 per 1M). Set a monthly budget cap
# in the OpenAI dashboard — that, not code, is the runaway-cost guard.
OPENAI_MODEL=gpt-5.6-luna

# How the bot calls Chatwoot's API. Default (unset) = http://rails:3000 on
# the private compose network — correct for local. On PRODUCTION set the
# public HTTPS URL: FORCE_SSL 301s plain-HTTP API calls to https://rails:3000,
# where TLS meets a plain port and every bot reply dies with
# ERR_SSL_WRONG_VERSION_NUMBER (found the hard way, 2026-08-03).
# CHATWOOT_BASE_URL=https://chat.flightsmojo.com

# The bot's identity in Chatwoot. ACCOUNT_ID is 1 on a fresh install (the
# staging Mac is 2 for historical reasons) — a wrong value means the bot
# receives messages but every reply silently 404s. BOT_TOKEN is printed by
# scripts/provision.rb; paste it here, then: docker compose up -d --no-deps bot
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=

# Booking status lookup tool (X-Api-Key auth). UAT endpoint works until the
# backend team supplies the production URL + key.
BOOKING_API_URL=
BOOKING_API_KEY=

# Per-inbox market map — this is what makes the bot quote the right currency.
# Keys are Chatwoot INBOX IDS (check the id|name|token lines provision.rb
# prints; a fresh install numbers the five web widgets 1-5, and WhatsApp
# inboxes added later continue from there). An inbox missing here gets a
# market-neutral prompt with no currency — no error, just vaguer answers.
INBOX_SITES={"1":"flightsmojo.in (India) — prices in ₹ INR","2":"flightsmojo.ae (UAE) — prices in AED","3":"flightsmojo.com (USA) — prices in $ USD","4":"flightsmojo.co.uk (UK) — prices in £ GBP","5":"flightsmojo.id (Indonesia) — prices in Rp IDR"}

# Bot auto-resolve: minutes of customer silence after a bot reply before the
# bot resolves the ticket itself. Defaults to 10 (in code) — only set this to
# change the window, or to 0 to turn it off. Only bot-owned ("pending") chats
# are eligible — human (open) conversations are never touched, and a
# returning customer flips the chat back to pending automatically.
#AUTO_RESOLVE_MINUTES=10

# Chatwoot signs agent-bot webhooks with the bot's secret (agent_bots.secret).
# Set it here and the bot rejects any /webhook call that isn't genuinely from
# Chatwoot. Unset = verification off (the bot warns at boot).
CHATWOOT_BOT_HMAC_SECRET=

# ── Cancellation routing (bot/handoff.js, bot/intent.js) — all OFF until set ──
# The team that owns cancellations and reschedules: Settings → Teams → open
# the team → the number in the URL. Turn on "Allow auto assign" on that team
# so Chatwoot picks one of its members. Unset = cancellations hand off like
# any other chat and nothing is routed.
CANCELLATION_TEAM_ID=
# Optional label added when routing (must exist in Settings → Labels).
CANCELLATION_LABEL=
# THE PER-MARKET SWITCH. A market listed here is ON: a cancellation there goes
# to the team above and the customer is told to call this number. A market
# missing here is OFF: the chat bot hands a cancellation to the humans like any
# other chat, and the intent checker leaves email/WhatsApp/tickets alone.
# India only for now (decided 2026-10-07). To turn a market on once it has a
# cancellation number: add its code + number, then `docker compose up -d --no-deps bot`.
# Codes = the market codes used in INBOX_COUNTRIES below; spaces or dashes in
# a number are shown to the customer exactly as typed.
CANCELLATION_PHONES={"IN":"00911246932002"}
# Desk hours per market — when the cancellations line is actually answered,
# as "HH:MM-HH:MM Zone" (IANA zone name). Outside them a customer gets the
# number only if travelling within CANCELLATION_URGENT_DAYS (default 1 =
# today or tomorrow); everyone else is told the team will call back first
# thing in the morning. Unset = the number at any hour.
CANCELLATION_DESK_HOURS={"IN":"09:00-21:00 Asia/Kolkata"}
#CANCELLATION_URGENT_DAYS=1
# Which market each inbox serves. "*" = read the ticket's `country` attribute
# (the Web Tickets inbox); a shared regional inbox gets its own code ("APAC").
# ONLY the inboxes listed here are watched by the intent checker — leave out
# any inbox (e.g. TripShield claims) that must never be touched.
INBOX_COUNTRIES={"1":"IN","2":"AE","3":"US","4":"UK","6":"US","7":"IN","8":"US","9":"*","10":"CA","12":"UK","13":"APAC","14":"APAC","15":"AE","16":"IN"}
# Secret of the ACCOUNT webhook that feeds the intent checker: Settings →
# Integrations → Webhooks → URL http://bot.flightsmojo.internal:3002/intent,
# only "Message created" ticked → copy its secret here. Unset = checker off.
CHATWOOT_WEBHOOK_SECRET=

# ── Storage ──
# local = files saved into the storage_data Docker volume (fine to start;
# switch to S3 when deploying for real).
ACTIVE_STORAGE_SERVICE=local

# Default UI language for new accounts.
DEFAULT_LOCALE=en

# ── Email sending (blank = emails silently skipped; fine for local testing) ──
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# ── Store reviews → tickets (reviews/ service) — every store OFF until set ──
# Design and the verified store facts: docs/store-reviews-to-chatwoot.md.
# Per store: an API inbox (Settings → Inboxes → Add → API) whose identifier
# goes in *_INBOX_IDENTIFIER, whose "Webhook URL" is
# http://reviews.flightsmojo.internal:3003/chatwoot and whose "Webhook secret"
# goes in *_WEBHOOK_SECRET (without it that store's replies stay read-only).
# Minutes between polls (Play allows 200 list calls per hour per app).
#REVIEWS_POLL_MINUTES=10
# First run imports only reviews from the last N days (the App Store and
# Google list their whole history).
#REVIEWS_BACKFILL_DAYS=7
# readonly (default): tickets only, agent replies are NOT sent to the stores
# (a private note on the ticket says so). post: the first public reply on a
# ticket becomes the store reply; later replies edit it.
#REVIEWS_REPLY_MODE=readonly
# Only reviews with this rating or lower become tickets (5 = all).
#REVIEWS_MAX_RATING=5
# Reviews already answered in a store console get no ticket unless true.
#REVIEWS_IMPORT_REPLIED=false

# Google Play — Google Play Developer API. Cloud project → enable "Google Play
# Developer API" → service account → download its JSON key; Play Console →
# Users and permissions → invite the service-account email with the
# "Reply to reviews" permission. Key as one line: base64 < key.json | tr -d '\n'
REVIEWS_PLAY_PACKAGE=
REVIEWS_PLAY_SERVICE_ACCOUNT_B64=
REVIEWS_PLAY_INBOX_IDENTIFIER=
REVIEWS_PLAY_WEBHOOK_SECRET=

# App Store — App Store Connect API key (Users and Access → Integrations →
# App Store Connect API). Replying needs the Customer Support role or higher.
# Key as one line: base64 < AuthKey_XXXX.p8 | tr -d '\n'. APP_ID = the numeric
# Apple ID of the app. REPLY_MAX_CHARS is optional (Apple documents no limit).
REVIEWS_APPLE_APP_ID=
REVIEWS_APPLE_ISSUER_ID=
REVIEWS_APPLE_KEY_ID=
REVIEWS_APPLE_KEY_B64=
REVIEWS_APPLE_INBOX_IDENTIFIER=
REVIEWS_APPLE_WEBHOOK_SECRET=
#REVIEWS_APPLE_REPLY_MAX_CHARS=

# Google reviews — Google Business Profile API v4. Needs Google's API access
# approval for the Cloud project first (0 QPM until approved), then an OAuth
# client and a refresh token for a Google account that is Owner or Manager of
# the listing (scope business.manage). Ids from the Account Management /
# Business Information APIs (accounts/{id}, locations/{id}).
REVIEWS_GOOGLE_ACCOUNT_ID=
REVIEWS_GOOGLE_LOCATION_ID=
REVIEWS_GOOGLE_CLIENT_ID=
REVIEWS_GOOGLE_CLIENT_SECRET=
REVIEWS_GOOGLE_REFRESH_TOKEN=
REVIEWS_GOOGLE_INBOX_IDENTIFIER=
REVIEWS_GOOGLE_WEBHOOK_SECRET=

# ── IROP mail triage (triage/ service) — all OFF until set ──
# Phase 1 of docs/irop-mail-triage.md: Postfix hands the agency mailbox's
# forward address to the service (scripts/email/triage-setup.sh); it classifies
# each mail with the bot's provider (BOT_PROVIDER / OPENAI_MODEL / GEMINI_MODEL
# above) and relays only IROP mail into Chatwoot. Ingest answers 503 (Postfix
# queues and retries) until RAILS_INBOUND_EMAIL_PASSWORD and a classifier key
# are present. Stamping (attributes, label, priority, team, note) needs the
# four TRIAGE_* lines below plus CHATWOOT_ACCOUNT_ID / CHATWOOT_BOT_TOKEN.
#
# The IROP inbox (Settings → Inboxes → the email inbox → the id in the URL)
# and the team that owns it (Settings → Teams → the team → the id in the URL;
# "Allow auto assign" on).
TRIAGE_INBOX_ID=
TRIAGE_TEAM_ID=
# Account webhook "IROP triage": URL http://triage.flightsmojo.internal:3004/chatwoot,
# only "Message created" ticked → copy its secret here. Create it AFTER the
# service is up (else Chatwoot times out on every delivery).
TRIAGE_WEBHOOK_SECRET=
# Separate key + budget cap for the classifier (falls back to OPENAI_API_KEY /
# GEMINI_API_KEY when unset). Keep the classifier and the chat bot from
# starving each other.
TRIAGE_OPENAI_API_KEY=
TRIAGE_GEMINI_API_KEY=
# Unsure mails: queue = ticket at low priority with label irop-unsure (the
# shadow-run setting); digest = no ticket, listed in the ledger only; drop.
TRIAGE_UNSURE=queue
# Priority from the first affected departure: days:priority bands, ascending.
TRIAGE_PRIORITY_BANDS=1:urgent,3:high,7:medium
# Our own addresses or domains: a mail THEY forward to the inbox is always a
# ticket, whatever the classifier thinks (comma-separated, e.g. flightsmojo.in).
TRIAGE_TRUSTED_SENDERS=
# Optional regex pre-filters (one pattern each): matching senders/subjects are
# logged as "other" without a model call. Empty = off.
TRIAGE_SKIP_SENDERS=
TRIAGE_SKIP_SUBJECTS=
# Where Chatwoot's relay ingress is reached from inside compose (default is
# right for production; the X-Forwarded-Proto header bypasses FORCE_SSL).
#TRIAGE_RELAY_URL=http://rails:3000/rails/action_mailbox/relay/inbound_emails
# Daily re-bump time (desk time zone) and the rest of the knobs — defaults in server.js.
#TRIAGE_REBUMP_HOUR=06:00
#TRIAGE_TIMEZONE=Asia/Kolkata
#TRIAGE_CLASSIFY_TIMEOUT_MS=20000
#TRIAGE_MAX_IN_FLIGHT=8
#TRIAGE_LEDGER_KEEP_DAYS=90
