#!/bin/sh
# Postfix -> Chatwoot hand-off.
#
# Postfix runs this once per email (see master.cf, service "chatwoot") with
# the raw message on stdin. We POST it unchanged to Chatwoot's Action Mailbox
# "relay" endpoint. Chatwoot answers 204 when it has stored the message.
#
# Exit codes follow <sysexits.h>, which Postfix understands:
#   0  = delivered      -> Postfix removes the message from its queue
#   75 = temporary fail -> Postfix keeps it queued and retries (Chatwoot down,
#                          wrong password, network blip). Nothing bounces.
set -u
CONF=/etc/postfix/chatwoot-ingress.env   # INGRESS_URL, INGRESS_PASSWORD (root:nogroup 0640)
if [ ! -r "$CONF" ]; then
  logger -t chatwoot-ingress "cannot read $CONF; message kept in queue for retry"
  exit 75
fi
. "$CONF"

code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 60 \
  -u "actionmailbox:$INGRESS_PASSWORD" \
  -A "FlightsMojo Postfix relayer" \
  -H "Content-Type: message/rfc822" \
  --data-binary @- "$INGRESS_URL" 2>/dev/null) || code="000"

case "$code" in
  200|204) exit 0 ;;
  *) logger -t chatwoot-ingress "Chatwoot answered HTTP $code; message kept in queue for retry"
     exit 75 ;;
esac
