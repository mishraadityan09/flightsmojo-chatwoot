#!/bin/sh
# Postfix -> IROP triage service hand-off (phase 1 of docs/irop-mail-triage.md).
#
# Postfix runs this once per email for the agency mailbox's forward address
# (see master.cf, service "triage") with the raw message on stdin. We POST it
# unchanged to the triage service on the loopback port; the service decides
# whether the mail becomes a Chatwoot ticket and relays it itself.
#
# Exit codes follow <sysexits.h>, which Postfix understands:
#   0  = handled        -> Postfix removes the message from its queue
#   75 = temporary fail -> Postfix keeps it queued and retries (service down,
#                          not configured yet, Chatwoot relay down). Nothing bounces.
set -u
CONF=/etc/postfix/triage-ingress.env   # INGRESS_URL (root:nogroup 0640)
if [ ! -r "$CONF" ]; then
  logger -t triage-ingress "cannot read $CONF; message kept in queue for retry"
  exit 75
fi
. "$CONF"

code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 90 \
  -A "FlightsMojo Postfix relayer" \
  -H "Content-Type: message/rfc822" \
  --data-binary @- "$INGRESS_URL" 2>/dev/null) || code="000"

case "$code" in
  200|204) exit 0 ;;
  *) logger -t triage-ingress "triage answered HTTP $code; message kept in queue for retry"
     exit 75 ;;
esac
